{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Perfil cli-rust-solo (modo enxuto). Derivado de templates/settings.template.json removendo: hooks de tenant, LGPD, on-call. Mantem destrutivos + segredos + frontmatter.",
  "_comment_perfil": "Solo: agente push direto em main, sem PR obrigatorio. Confirmar so para cargo publish/yank.",
  "model": "claude-opus-4-7",
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(ls:*)", "Bash(pwd:*)", "Bash(which:*)", "Bash(echo:*)",
      "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(find:*)",
      "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)",
      "Bash(grep:*)", "Bash(sed:*)", "Bash(awk:*)", "Bash(wc:*)",
      "Bash(sort:*)", "Bash(uniq:*)", "Bash(tr:*)", "Bash(cut:*)",
      "Bash(date:*)", "Bash(test:*)", "Bash(true:*)", "Bash(false:*)",
      "Bash(env:*)", "Bash(printenv:*)", "Bash(basename:*)", "Bash(dirname:*)",
      "Bash(stat:*)", "Bash(file:*)", "Bash(diff:*)", "Bash(chmod:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git show:*)", "Bash(git branch:*)", "Bash(git checkout:*)",
      "Bash(git switch:*)", "Bash(git stash:*)", "Bash(git fetch:*)",
      "Bash(git pull:*)", "Bash(git rev-parse:*)", "Bash(git ls-files:*)",
      "Bash(git config:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git push origin:*)", "Bash(git push --set-upstream:*)",
      "Bash(git revert:*)", "Bash(git tag:*)", "Bash(git remote:*)",
      "Bash(gh:*)", "Bash(jq:*)", "Bash(rg:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)", "Bash(rm -fr:*)", "Bash(rm -Rf:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(git clean -fd:*)", "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(cargo publish:*)", "Bash(cargo yank:*)",
      "Bash(sudo:*)", "Bash(mkfs:*)", "Bash(dd if=:*)", "Bash(dd of=:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-deps.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/override-ledger.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive.sh\"" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secrets-scanner.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/anti-mascaramento.sh\"" }
        ]
      }
    ]
  },
  "env": {
    "PROJECT_NAME": "cli-rust-solo"
  },
  "additionalDirectories": [
    "docs",
    ".agent",
    ".claude"
  ]
}
